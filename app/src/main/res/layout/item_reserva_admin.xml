<?xml version="1.0" encoding="utf-8"?>
<!-- Christian · D01 Reservas: tarjeta de una reserva
     #6 · Sala ejecutiva A            [Pendiente]
     (persona)    Mariana Hernández
     (calendario) 20/11/2026 · 11:00 a 15:00
     Motivo: Junta de trabajo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/admin_borde_tarjeta"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/admin_azul_marino"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="#6 · Sala ejecutiva A" />

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_admin_etiqueta"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:backgroundTint="@color/admin_pendiente_fondo"
                tools:text="Pendiente"
                tools:textColor="@color/admin_pendiente_texto" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/admin_texto_secundario"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_admin_persona"
            app:drawableTint="@color/admin_texto_secundario"
            tools:text="Mariana Hernández" />

        <TextView
            android:id="@+id/txtFechaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/admin_texto_secundario"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_admin_calendario"
            app:drawableTint="@color/admin_texto_secundario"
            tools:text="20/11/2026 · 11:00 a 15:00" />

        <TextView
            android:id="@+id/txtMotivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/admin_texto_secundario"
            android:textSize="15sp"
            tools:text="Motivo: Junta de trabajo" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
