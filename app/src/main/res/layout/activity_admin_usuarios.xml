<?xml version="1.0" encoding="utf-8"?>
<!-- D02 Usuarios (administrador): barra superior, buscador por nombre o correo,
     chips de tipo, lista de usuarios y barra inferior (Reservas, Usuarios, Cancelaciones) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_fondo_pantalla"
    tools:context=".Vista.AdminUsuariosActivity">

    <!-- Barra superior: título, cerrar sesión y logo -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/admin_azul_marino"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Usuarios"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:src="@drawable/ic_admin_salir"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_admin_logo"
            android:gravity="center"
            android:text="VITÁN"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Buscador: la búsqueda la hace el presentador sobre la lista -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscar"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/admin_azul_marino"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezado"
        app:startIconDrawable="@drawable/ic_admin_buscar"
        app:startIconTint="@color/admin_gris_inactivo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por nombre o correo"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Chips de tipo de usuario: el filtro lo hace la API -->
    <HorizontalScrollView
        android:id="@+id/scrollTipos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilBuscar">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoTipos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos"
                android:textColor="@color/admin_chip_texto"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/admin_chip_fondo"
                app:chipCornerRadius="50dp"
                app:chipStrokeColor="@color/admin_borde_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipClientes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textColor="@color/admin_chip_texto"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/admin_chip_fondo"
                app:chipCornerRadius="50dp"
                app:chipStrokeColor="@color/admin_borde_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEmpresas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empresas"
                android:textColor="@color/admin_chip_texto"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/admin_chip_fondo"
                app:chipCornerRadius="50dp"
                app:chipStrokeColor="@color/admin_borde_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdmin"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="@color/admin_chip_texto"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/admin_chip_fondo"
                app:chipCornerRadius="50dp"
                app:chipStrokeColor="@color/admin_borde_chip" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Lista de usuarios (cada tarjeta es item_usuario_admin.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsuarios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/barraInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollTipos"
        tools:listitem="@layout/item_usuario_admin" />

    <!-- Estado de carga mientras responde la API -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/admin_azul_marino"
        app:layout_constraintBottom_toBottomOf="@id/rvUsuarios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvUsuarios" />

    <!-- "No hay usuarios" o el mensaje de error -->
    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:textColor="@color/admin_texto_secundario"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvUsuarios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvUsuarios"
        tools:text="No hay usuarios" />

    <!-- Barra inferior del administrador -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barraInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconTint="@color/admin_barra_item"
        app:itemTextColor="@color/admin_barra_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_admin" />
</androidx.constraintlayout.widget.ConstraintLayout>
